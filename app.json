{
  "expo": {
    "name": "Village",
    "slug": "village-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/village-icon.png",
    "scheme": "village",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.village.mobile",
      "associatedDomains": ["applinks:links.village.app"]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/village-mark.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.village.mobile",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "links.village.app",
              "pathPrefix": "/"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/village-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Village uses the selected photo as a private child or caregiver avatar.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/village-mark.png",
          "resizeMode": "contain",
          "backgroundColor": "#F4FAF8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
